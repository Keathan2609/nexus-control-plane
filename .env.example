# NEXUS configuration.
#
# Every value here has a working default for local development. The two secrets are the
# exception: NEXUS_ENVIRONMENT=production refuses to start without them, so a production
# deployment cannot silently run on the development signing key.

# --- core -------------------------------------------------------------------
NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=info
NEXUS_LOG_FORMAT=text

NEXUS_DATABASE_URL=postgres://nexus:nexus@localhost:5436/nexus?sslmode=disable
NEXUS_NATS_URL=nats://localhost:4222

NEXUS_HTTP_ADDR=:8080
NEXUS_METRICS_ADDR=:9095

# --- secrets ----------------------------------------------------------------
# Required in production. The JWT secret must be at least 32 bytes; generate one with:
#   openssl rand -base64 48
NEXUS_AUTH_JWT_SECRET=
NEXUS_WEBHOOK_SECRET=

# --- execution --------------------------------------------------------------
NEXUS_WORKER_CONCURRENCY=4
# A lease shorter than a few multiples of the heartbeat interval will be reaped out from
# under a healthy worker. The heartbeat is a third of this value.
NEXUS_WORKER_LEASE_SECONDS=30
NEXUS_WORKER_POLL_INTERVAL=500ms

# --- control loops ----------------------------------------------------------
NEXUS_RECONCILE_INTERVAL=10s
NEXUS_OUTBOX_INTERVAL=1s
NEXUS_OUTBOX_BATCH_SIZE=128

# --- telemetry --------------------------------------------------------------
# Unset means tracing is a no-op; a missing collector never blocks startup.
NEXUS_OTEL_ENDPOINT=
NEXUS_TRACE_SAMPLE_RATE=1.0

# --- console ----------------------------------------------------------------
NEXUS_CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8080
